{
  "name": "morse-tone",
  "version": "0.1.0",
  "description": "Morse code audio with ITU-R M.1677-1 timing. Zero dependencies, works in Node and the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "example": "npm run build && node examples/gen-sos.js"
  },
  "keywords": [
    "morse",
    "morse-code",
    "cw",
    "itu",
    "audio",
    "wav",
    "telegraph",
    "ham-radio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
